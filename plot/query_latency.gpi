set terminal pngcairo size 1000,450 enhanced font 'Verdana,20'
set output 'query_latency.png'

set title ""

set key top left

set xlabel "Number of NetFlow Records"
set xtics ("50" 1, "100" 2, "500" 3, "1000" 4, "2000" 5)

# Left Y-axis for generation latency (in seconds)
set ylabel "Generation Latency (sec)"
#set ytics (100, 200, 400, 800, 1600) nomirror
set ytics nomirror

# Right Y-axis for verification latency (in milliseconds)
set y2label "Verification Latency (ms)"
#set y2tics 200
set y2range [0:2000]
set y2tics 400
set grid

# Plot: generation latency converted to seconds, verification latency unchanged
plot 'latency.data' using 1:($5/1000.0) with linespoints lt rgb "#1f77b4" lw 2 pt 7 title 'Proof Generation (s)', \
     '' using 1:6 axes x1y2 with linespoints lt rgb "#ff7f0e" lw 2 pt 5 title 'Proof Verification (ms)'
